# https://network.satnogs.org API Key. Free to make an account.
# SATNOGS_NETWORK_API_KEY=XXXXXX

# Where cts1_processing_pipeline's daemon/web UI read and write their
# DuckDB database + parquet files. Defaults to ./output if unset -- see
# packages/cts1_mo_tools/DEPLOY.md
# CTS1_DATA_DIR=output

# Signs the cookie the web UI uses to remember each browser's dark-mode
# preference. Not sensitive (no login on this dashboard) -- has a fixed
# fallback if unset, so this is only worth setting if you want it unique
# per deployment.
# CTS1_WEB_STORAGE_SECRET=some-random-string
