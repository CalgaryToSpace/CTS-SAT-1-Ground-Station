# syntax=docker/dockerfile:1

# Serves the CTS-SAT-1 processing pipeline's NiceGUI web UI
# (`cts1_data_web_ui`) -- a read-only view over the parquet/duckdb files
# `daemon` (see Dockerfile.daemon) writes to `CTS1_DATA_DIR`. Fully
# self-contained: unlike the daemon, this image needs nothing beyond
# Python + the workspace's own pip-installable dependencies.
#
# Build from the repo root (not this directory) -- see DEPLOY.md for why.
# See DEPLOY.md for how this is meant to be run alongside Dockerfile.daemon,
# sharing `CTS1_DATA_DIR` as a bind mount.

# ---- git-commit stage (only stage with git installed, discarded after) ----
FROM python:3.13-slim AS gitinfo
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
# Just the git metadata -- git rev-parse needs no working-tree files.
COPY .git .git
RUN git rev-parse --short HEAD > /project_git_commit

# ----- Final image ----
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

WORKDIR /repo

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/repo/.venv \
    PATH=/repo/.venv/bin:$PATH \
    CTS1_DATA_DIR=/opt/cts1_processing_pipeline

# The whole uv workspace is copied in (not just cts1_mo_tools) since `uv
# sync` resolves against the workspace's single shared uv.lock -- every
# member's pyproject.toml needs to be present even though only
# cts1_mo_tools actually gets installed below.
COPY . .

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package cts1_mo_tools

# Bake the build date and git commit into the image -- the commit comes
# from the `gitinfo` stage above so the final image itself never needs git
# installed.
RUN date -u +%Y-%m-%dT%H:%M:%SZ > /etc/project_build_date
COPY --from=gitinfo /project_git_commit /etc/project_git_commit

VOLUME ["/opt/cts1_processing_pipeline"]
EXPOSE 8089

ENTRYPOINT ["cts1_data_web_ui"]
CMD ["--port", "8089"]
