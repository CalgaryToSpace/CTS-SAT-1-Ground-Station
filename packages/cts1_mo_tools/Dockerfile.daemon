# syntax=docker/dockerfile:1

# Runs the CTS-SAT-1 processing pipeline's `daemon` subcommand (steps 1-3
# on a loop -- see src/cts1_mo_tools/cts1_processing_pipeline/README.md and
# ../DEPLOY.md), writing to `CTS1_DATA_DIR`.

# ---- askew-radio-tools build stage (Rust; not needed in the final image) ----
FROM rust:1-slim-bookworm AS askew-build
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install --locked \
        --git https://github.com/parker-research/askew-radio-tools \
        askew-radio-tools

# ----- Final image ----
FROM python:3.13-slim-bookworm

COPY --from=askew-build /usr/local/cargo/bin/askew_demod_from_file /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
        sox \
        libssl3 \
        libsndfile1 \
        libsqlite3-0 \
        libncurses6 \
        libsndfile1-dev \
        libsqlite3-dev \
        libncurses-dev \
        gnuradio \
        gnuradio-dev \
        libvolk2-dev \
        pkg-config \
        build-essential \
        cmake \
        git \
        ca-certificates \
        libssl-dev \
        python3-requests python3-construct python3-websocket \
    && rm -rf /var/lib/apt/lists/*

# ----- Build gr_satellites ----
# Guide: https://gr-satellites.readthedocs.io/en/latest/installation.html
WORKDIR /src
RUN git clone https://github.com/parker-research/gr-satellites
WORKDIR /src/gr-satellites
# Checkout specific commit with my timestamping improvement.
RUN git checkout 6406540453bee26964e96fb41d2e6163994bed82
WORKDIR /src/gr-satellites/build
RUN cmake ..
RUN make -j8
RUN make install
RUN ldconfig

# ---- Build sso_rx_replay --------
WORKDIR /src
RUN git clone https://github.com/JohnathanBurchill/simple_sat_ops
WORKDIR /src/simple_sat_ops
# Pin working commit.
RUN git checkout 525ed50261f556b6b260edcc988ee0e2ff4fd478
WORKDIR /src/simple_sat_ops/build
RUN cmake .. -DWITH_USRP_B210=OFF
RUN make -j8 rx_replay
RUN cp rx_replay /usr/local/bin/sso_rx_replay
RUN ldconfig

# ----- Validate tool installs -----
RUN askew_demod_from_file --version
RUN sso_rx_replay --version
RUN gr_satellites --version

# ----- Install cts1_mo_tools ----

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /uvx /bin/

WORKDIR /repo

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/repo/.venv \
    PATH=/repo/.venv/bin:$PATH \
    CTS1_DATA_DIR=/opt/cts1_processing_pipeline

# The whole uv workspace is copied in (not just cts1_mo_tools) since `uv
# sync` resolves against the workspace's single shared uv.lock -- every
# member's pyproject.toml needs to be present even though only
# cts1_mo_tools actually gets installed below.
COPY . .

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package cts1_mo_tools

VOLUME ["/opt/cts1_processing_pipeline"]

ENTRYPOINT ["cts1_processing_pipeline", "daemon"]
